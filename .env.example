# App identity
NEXT_PUBLIC_APP_NAME="Klipper Banua"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (local dev values come from `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only secrets. Never import these from a client component.
SUPABASE_SERVICE_ROLE_KEY=""
CLICK_IP_HASH_SALT=""

# Display timezone (WITA by default; WIB for Kalbar/Kalteng users)
DEFAULT_TIMEZONE="Asia/Makassar"

# Optional (v1.1): bearer token n8n uses for the daily snapshot reminder.
# Generate with `openssl rand -hex 32`; leave empty to disable the endpoint.
REMINDER_API_TOKEN=""

# Seed account created by `npm run seed:owner`
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Owner"

# Optional manager account for RLS testing
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD=""
SEED_MANAGER_NAME="Manager"

# Optional creator portal account for the demo data (v2.0, M13).
# `npm run seed:demo` links it to the first demo creator.
SEED_CREATOR_EMAIL="kreator@example.com"
SEED_CREATOR_PASSWORD=""

# --- Production only (.env.production on the VPS, see DEPLOY.md) ---
# Domain served by Caddy with automatic HTTPS, e.g. app.contoh.id
APP_DOMAIN=""
