# App identity
NEXT_PUBLIC_APP_NAME="Klipper Banua"
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Public site contact button (M15, v3.1). Empty = the button is left out.
NEXT_PUBLIC_CONTACT_WA="6282254866889"

# Supabase (local dev values come from `npm run db:start`)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:55321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only secrets. Never import these from a client component.
SUPABASE_SERVICE_ROLE_KEY=""
CLICK_IP_HASH_SALT=""

# Display timezone (WITA by default; WIB for Kalbar/Kalteng users)
DEFAULT_TIMEZONE="Asia/Makassar"

# Optional (v1.1): bearer token n8n uses for the daily snapshot reminder.
# Generate with `openssl rand -hex 32`; leave empty to disable the endpoint.
REMINDER_API_TOKEN=""

# Optional: SMTP for klipper notification emails (clip verified, withdrawal
# paid; FR-M18-09, FR-M19-09). Leave SMTP_HOST or EMAIL_FROM empty to turn
# them off. Local dev: Mailpit from `npm run db:start` (view at :55324).
SMTP_HOST="127.0.0.1"
SMTP_PORT="55325"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Klipper Banua <no-reply@example.com>"

# Seed account created by `npm run seed:owner`
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""
SEED_OWNER_NAME="Owner"

# Optional manager account for RLS testing
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD=""
SEED_MANAGER_NAME="Manager"

# Optional creator portal account for the demo data (v2.0, M13).
# `npm run seed:demo` links it to the first demo creator.
SEED_CREATOR_EMAIL="kreator@example.com"
SEED_CREATOR_PASSWORD=""

# Optional client portal account for the demo data (v3.0, M14).
# `npm run seed:demo` links it to the demo client's primary contact.
SEED_CLIENT_EMAIL="klien@example.com"
SEED_CLIENT_PASSWORD=""

# --- Production only (.env.production on the VPS, see DEPLOY.md) ---
# Domain served by Caddy with automatic HTTPS, e.g. app.contoh.id
APP_DOMAIN=""
