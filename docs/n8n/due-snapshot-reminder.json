{
  "name": "Kliper Banua - pengingat snapshot jatuh tempo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 8 * * *" }]
        }
      },
      "id": "5d0c3f5e-1b8a-4a51-9d5e-000000000001",
      "name": "Setiap hari 08.00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "http://kliper-banua-app:3000/api/reminders/due-snapshots",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 30000 }
      },
      "id": "5d0c3f5e-1b8a-4a51-9d5e-000000000002",
      "name": "Ambil snapshot jatuh tempo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Kliper Banua reminder token" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "5d0c3f5e-1b8a-4a51-9d5e-0000000000c1",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5d0c3f5e-1b8a-4a51-9d5e-000000000003",
      "name": "Ada yang jatuh tempo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "chatId": "GANTI_DENGAN_CHAT_ID_OWNER",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "parse_mode": "HTML"
        }
      },
      "id": "5d0c3f5e-1b8a-4a51-9d5e-000000000004",
      "name": "Kirim ke Telegram owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, -80],
      "credentials": {
        "telegramApi": { "id": "", "name": "Kliper Banua bot" }
      }
    }
  ],
  "connections": {
    "Setiap hari 08.00": {
      "main": [[{ "node": "Ambil snapshot jatuh tempo", "type": "main", "index": 0 }]]
    },
    "Ambil snapshot jatuh tempo": {
      "main": [[{ "node": "Ada yang jatuh tempo?", "type": "main", "index": 0 }]]
    },
    "Ada yang jatuh tempo?": {
      "main": [[{ "node": "Kirim ke Telegram owner", "type": "main", "index": 0 }], []]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Makassar" },
  "pinData": {}
}
